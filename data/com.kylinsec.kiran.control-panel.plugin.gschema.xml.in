<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="com.kylinsec.kiran.control-panel.plugin" path="/com/kylinsec/kiran/control-panel/">
        <key name="show-ipv4-gateway" type="b">
            <default>true</default>
            <summary>Show gateway in IPv4 setting</summary>
            <description>Whether to show the IPv4 gateway field in IPv4 setting page for network plugins.</description>
        </key>
        <key name="only-current-language" type="b">
            <default>true</default>
            <summary>Only show input methods for the current language</summary>
            <description>Whether to limit input method candidates to the current and enabled language families.</description>
        </key>
        <key name="enable-keyboard-layout-subitem" type="b">
            <default>false</default>
            <summary>Enable the keyboard layout setting item</summary>
            <description>Whether the keyboard plugin provides the keyboard layout setting item. Disable it when the input method plugin takes over keyboard layout configuration to avoid both sides rewriting the XKB settings.</description>
        </key>
        <!-- 默认值由构建参数 SERVER_MODE 生成，仅为兼容性；定制化推荐经 kiran-desktop 的 override 覆写 -->
        <key name="server-mode" type="b">
            <default>@KCP_SERVER_MODE_DEFAULT@</default>
            <summary>Server Mode</summary>
            <description>Whether the Control Center is running in server mode.</description>
        </key>
    </schema>
</schemalist>
